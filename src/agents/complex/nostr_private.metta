; Family 9, private: a proposed step of delivering private messages (NIP-17, NIP-04).
(complex nostr_private)
(skill nip17_plan)
(atom proposal-parses)
(atom tool-known)
(atom same-tool)
(atom proposes-commit)
(atom reference-commits)
(atom turn)
(atom attempts-left)
(atom blocks-left)
(atom last-rejected)
(atom fetch-proposed)
(atom wrap-step-proposed)
(atom publish-proposed)
(atom relays-named)
(atom handles-held)
(rule parses)
(rule known-tool)
(rule args-object)
(rule known-relays)
(rule known-handle)
(rule no-cleartext)
(operator reference)
(gate commit reference)
